      <column caption='Financial Month' datatype='integer' name='[Calculation_0884576719945741]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF MONTH([Calculation_0884576707956737]) &gt;= 4 THEN&#13;&#10;    MONTH([Calculation_0884576707956737]) - 3&#13;&#10;ELSE&#13;&#10;    MONTH([Calculation_0884576707956737]) + 9&#13;&#10;END' />
