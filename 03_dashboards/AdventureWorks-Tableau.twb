      </column>
      <column caption='Month Full Name' datatype='string' name='[Calculation_0884576719015944]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='CASE MONTH([Calculation_0884576707956737])&#13;&#10;WHEN 1 THEN &quot;January&quot;&#13;&#10;WHEN 2 THEN &quot;February&quot;&#13;&#10;WHEN 3 THEN &quot;March&quot;&#13;&#10;WHEN 4 THEN &quot;April&quot;&#13;&#10;WHEN 5 THEN &quot;May&quot;&#13;&#10;WHEN 6 THEN &quot;June&quot;&#13;&#10;WHEN 7 THEN &quot;July&quot;&#13;&#10;WHEN 8 THEN &quot;August&quot;&#13;&#10;WHEN 9 THEN &quot;September&quot;&#13;&#10;WHEN 10 THEN &quot;October&quot;&#13;&#10;WHEN 11 THEN &quot;November&quot;&#13;&#10;WHEN 12 THEN &quot;December&quot;&#13;&#10;END' />
      </column>
      <column caption='Quarter' datatype='string' name='[Calculation_0884576719290377]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Q&quot; + STR(DATEPART(&apos;quarter&apos;, [Calculation_0884576707956737]))' />
      </column>
      <column caption='Year-Month' datatype='string' name='[Calculation_0884576719441930]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(YEAR([Calculation_0884576707956737])) + &quot;-&quot; + LEFT(DATENAME(&apos;month&apos;, [Calculation_0884576707956737]), 3)' />
      </column>
      <column caption='WeekNo' datatype='integer' name='[Calculation_0884576719605771]' role='measure' type='quantitative'>
